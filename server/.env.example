# docker-compose.yaml が使う設定。このファイルを .env という名前でコピーして使う（.env は git に入れない）
#   cp .env.example .env

# CLI とサーバーで共有するトークン（32文字以上）。作り方の例: openssl rand -hex 32
REPO_TWEAKS_TOKEN=

# 待ち受ける IP アドレスとポート。Mac で試すときは 127.0.0.1 のまま
# NAS で LAN に公開するときは NAS の LAN の IP（例: 192.0.2.10）にする。0.0.0.0 にしない
REPO_TWEAKS_BIND_IP=127.0.0.1
REPO_TWEAKS_PORT=8107
# CLI やブラウザがサーバーを呼ぶときのホスト名。カンマで区切る。* は使わない
# NAS なら、その IP を足す（例: localhost,127.0.0.1,192.0.2.10）
REPO_TWEAKS_ALLOWED_HOSTS=localhost,127.0.0.1

# メモリに残す通知の件数（1〜1000。再起動で消える）
REPO_TWEAKS_MAX_EVENTS=100
